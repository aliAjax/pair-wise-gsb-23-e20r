{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5109",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5109",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hxwl-verify.mjs && node node_modules/.cache/hxwl-verify.mjs",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/hxwl-smoke.cjs && node node_modules/.cache/hxwl-smoke.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
